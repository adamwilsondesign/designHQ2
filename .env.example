# Which Firebase project the web app talks to.
#   rebuild  the new DesignHQ project (configure the VITE_FIREBASE_* values below)
#   legacy   the production DesignHQ project in firebase-applet-config.json (read/write!)
# The app refuses to start when this is unset so nobody points a dev build at
# production by accident.
VITE_FIREBASE_TARGET=rebuild

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Leave empty to use the (default) database.
VITE_FIREBASE_DATABASE_ID=
# Cloud Functions region (must match functions/src/index.ts).
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# Set to true to talk to local emulators (npx firebase emulators:start).
VITE_USE_EMULATORS=false

{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the system with role-based access",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "name": {
          "type": "string",
          "description": "User's full name"
        },
        "role": {
          "type": "string",
          "enum": [
            "Super Admin",
            "Admin",
            "Regular User"
          ],
          "description": "User's role"
        },
        "avatar": {
          "type": "string",
          "description": "URL to user's avatar"
        },
        "staffId": {
          "type": "string",
          "description": "Staff record this sign-in belongs to. Lets Regular Users see their own assignments. Set by a Super Admin or the migration script."
        }
      },
      "required": [
        "email",
        "name",
        "role"
      ]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "A staff member in the organization",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Staff member's name"
        },
        "personalEmail": {
          "type": "string",
          "format": "email",
          "description": "Staff member's personal email"
        },
        "lazerEmail": {
          "type": "string",
          "format": "email",
          "description": "Staff member's Lazer email"
        },
        "location": {
          "type": "string",
          "description": "Staff member's location"
        },
        "timezone": {
          "type": "string",
          "description": "Staff member's timezone"
        },
        "employmentType": {
          "type": "string",
          "description": "Type of employment (e.g., Full-Time, Contractor)"
        },
        "hourlyCost": {
          "type": "number",
          "description": "Hourly cost of the staff member"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of skills"
        }
      },
      "required": [
        "name",
        "location",
        "timezone",
        "employmentType",
        "hourlyCost",
        "skills"
      ]
    },
    "Project": {
      "title": "Project",
      "description": "A project being worked on",
      "type": "object",
      "properties": {
        "client": {
          "type": "string",
          "description": "Client name"
        },
        "lob": {
          "type": "string",
          "description": "Line of business"
        },
        "type": {
          "type": "string",
          "description": "Project type"
        },
        "clientLocation": {
          "type": "string",
          "description": "Client's location"
        },
        "status": {
          "type": "string",
          "enum": [
            "Open",
            "Closed",
            "Lost"
          ],
          "description": "Project status"
        },
        "totalHours": {
          "type": "number",
          "description": "Total estimated hours"
        },
        "billedRate": {
          "type": "number",
          "description": "Hourly billed rate"
        },
        "totalValue": {
          "type": "number",
          "description": "Total project value"
        },
        "startDate": {
          "type": "string",
          "description": "Project start date"
        },
        "finishDate": {
          "type": "string",
          "description": "Project finish date"
        },
        "assignedStaffIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of assigned staff IDs"
        },
        "staffAllocations": {
          "type": "object",
          "description": "Map of staff IDs to their allocation percentage (0-100)"
        },
        "designSourced": {
          "type": "boolean",
          "description": "Whether the deal was sourced by design"
        },
        "designClosed": {
          "type": "boolean",
          "description": "Whether the deal was closed by design"
        }
      },
      "required": [
        "client",
        "lob",
        "type",
        "clientLocation",
        "status",
        "totalHours",
        "billedRate",
        "totalValue",
        "startDate",
        "finishDate",
        "assignedStaffIds"
      ]
    },
    "Sale": {
      "title": "Sale",
      "description": "A sales lead or opportunity",
      "type": "object",
      "properties": {
        "client": {
          "type": "string",
          "description": "Client name"
        },
        "lob": {
          "type": "string",
          "description": "Line of business"
        },
        "type": {
          "type": "string",
          "description": "Project type"
        },
        "clientLocation": {
          "type": "string",
          "description": "Client's location"
        },
        "status": {
          "type": "string",
          "enum": [
            "Open",
            "In Negotiation",
            "Closed",
            "Lost"
          ],
          "description": "Sale status"
        },
        "projectedValue": {
          "type": "number",
          "description": "Projected total value"
        },
        "projectedHours": {
          "type": "number",
          "description": "Projected total hours"
        },
        "projectedRate": {
          "type": "number",
          "description": "Projected hourly rate"
        },
        "lastContactDate": {
          "type": "string",
          "description": "Date of last contact"
        },
        "designSourced": {
          "type": "boolean",
          "description": "Whether the deal was sourced by design"
        },
        "designClosed": {
          "type": "boolean",
          "description": "Whether the deal was closed by design"
        },
        "projectedCloseDate": {
          "type": "string",
          "description": "Present on the client type but NOT persisted by App.tsx handleSetSalesList (pre-existing behaviour, left unchanged)."
        }
      },
      "required": [
        "client",
        "lob",
        "type",
        "clientLocation",
        "status",
        "projectedValue",
        "projectedHours",
        "projectedRate",
        "lastContactDate"
      ]
    },
    "StaffProfile": {
      "title": "StaffProfile",
      "description": "Extended staff data, keyed by the staff document id. Kept in its own collection because App.tsx overwrites whole staff documents on save. Entered manually by Adam from Rippling; no self-service.",
      "type": "object",
      "properties": {
        "birthday": {
          "type": [
            "string",
            "null"
          ],
          "description": "YYYY-MM-DD"
        },
        "companyJoinDate": {
          "type": [
            "string",
            "null"
          ],
          "description": "YYYY-MM-DD"
        },
        "ptoDates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "holidays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "lastOneOnOneDate": {
          "type": [
            "string",
            "null"
          ],
          "description": "YYYY-MM-DD of the most recent one-on-one"
        },
        "oneOnOneCadence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "monthly",
            "sixWeeks",
            null
          ],
          "description": "Set by Adam per person"
        },
        "lastShowAndTellDate": {
          "type": [
            "string",
            "null"
          ],
          "description": "Last design-team show-and-tell this person presented"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ProjectMeta": {
      "title": "ProjectMeta",
      "description": "Extended project data keyed by project id (health status for the exec update). Separate collection for the same reason as StaffProfile.",
      "type": "object",
      "properties": {
        "healthStatus": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "On Track",
            "At Risk",
            "Off Track",
            null
          ]
        },
        "healthNote": {
          "type": "string"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Task": {
      "title": "Task",
      "description": "Personal to-do shown on the daily dashboard.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "dueDate": {
          "type": "string"
        },
        "done": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "ownerUid",
        "title"
      ]
    },
    "ProposalTemplate": {
      "title": "ProposalTemplate",
      "description": "One of the four proposal variants (doc id = variant: commerce-eng, commerce-design, core-eng, core-design). The .docx lives in Storage under professional/templates/.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "storagePath": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "uploadedAt": {
          "type": "string"
        },
        "parseStatus": {
          "type": "string",
          "enum": [
            "pending",
            "parsed",
            "error"
          ]
        },
        "parseError": {
          "type": [
            "string",
            "null"
          ]
        },
        "preamble": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "heading": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "static",
                  "variable"
                ]
              },
              "key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "needsReview": {
                "type": "boolean"
              },
              "confirmed": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "hasTable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "Proposal": {
      "title": "Proposal",
      "type": "object",
      "properties": {
        "clientName": {
          "type": "string"
        },
        "templateId": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Adam's free-form engagement notes"
        },
        "transcripts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "new",
            "draft"
          ]
        },
        "draft": {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer"
            },
            "sections": {
              "type": "array"
            },
            "openQuestions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "generatedAt": {},
            "generatedBy": {
              "type": "string"
            }
          }
        },
        "reviewNotes": {
          "type": "string"
        },
        "sectionNotes": {
          "type": "object"
        },
        "history": {
          "type": "array"
        },
        "docxPath": {
          "type": "string"
        },
        "docxVersion": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        }
      }
    },
    "Meeting": {
      "title": "Meeting",
      "description": "One occurrence of a one-on-one, town hall, critique or design team meeting.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "oneOnOne",
            "townHall",
            "critique",
            "designTeam"
          ]
        },
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "description": "ISO start"
        },
        "durationMinutes": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": [
            "scheduled",
            "held",
            "cancelled"
          ]
        },
        "staffId": {
          "type": [
            "string",
            "null"
          ]
        },
        "staffName": {
          "type": [
            "string",
            "null"
          ]
        },
        "seriesId": {
          "type": [
            "string",
            "null"
          ]
        },
        "presenters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agenda": {
          "type": "string"
        },
        "calendarEventId": {
          "type": [
            "string",
            "null"
          ]
        },
        "calendarLink": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcriptPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcriptName": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actionItems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string"
              },
              "task": {
                "type": "string"
              },
              "due": {
                "type": "string"
              },
              "done": {
                "type": "boolean"
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adamNotes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        }
      }
    },
    "MeetingSeries": {
      "title": "MeetingSeries",
      "description": "Recurring town hall, critique or design team meeting.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "townHall",
            "critique",
            "designTeam"
          ]
        },
        "name": {
          "type": "string"
        },
        "cadenceWeeks": {
          "type": "integer"
        },
        "leadTimeDays": {
          "type": "integer"
        },
        "durationMinutes": {
          "type": "integer"
        },
        "attendees": {
          "type": "string"
        },
        "lastHeldDate": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ExecUpdate": {
      "title": "ExecUpdate",
      "description": "Saved copy of a generated Slack exec update.",
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "since": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "manual": {
          "type": "object"
        },
        "includedClosed": {
          "type": "array"
        },
        "includedScoped": {
          "type": "array"
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles and roles"
    },
    "/staff/{staffId}": {
      "schema": {
        "$ref": "#/entities/StaffMember"
      },
      "description": "Stores staff members"
    },
    "/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/Project"
      },
      "description": "Stores projects"
    },
    "/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/Sale"
      },
      "description": "Stores sales leads"
    },
    "/staffProfiles/{staffId}": {
      "schema": {
        "$ref": "#/entities/StaffProfile"
      },
      "description": "Extended staff fields. Admin+ only."
    },
    "/projectMeta/{projectId}": {
      "schema": {
        "$ref": "#/entities/ProjectMeta"
      },
      "description": "Project health. Admin+ only."
    },
    "/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/Task"
      },
      "description": "Owner-only tasks."
    },
    "/personal/{uid}/...": {
      "description": "All personal-module data for a Super Admin (profile hub, social drafts, calendar reminders, job applications, resume drafts). Owner Super Admin only."
    },
    "/integrations/{uid}/...": {
      "description": "OAuth tokens. Server-only (Cloud Functions); clients are denied."
    },
    "/proposalTemplates/{variant}": {
      "schema": {
        "$ref": "#/entities/ProposalTemplate"
      },
      "description": "Admin+ only."
    },
    "/proposals/{proposalId}": {
      "schema": {
        "$ref": "#/entities/Proposal"
      },
      "description": "Admin+ only."
    },
    "/meetings/{meetingId}": {
      "schema": {
        "$ref": "#/entities/Meeting"
      },
      "description": "Admin+ only."
    },
    "/meetingSeries/{seriesId}": {
      "schema": {
        "$ref": "#/entities/MeetingSeries"
      },
      "description": "Admin+ only."
    },
    "/execUpdates/{id}": {
      "schema": {
        "$ref": "#/entities/ExecUpdate"
      },
      "description": "Admin+ only."
    }
  }
}
{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": ["node scripts/guard-deploy.mjs"]
  },
  "storage": {
    "rules": "storage.rules",
    "predeploy": ["node scripts/guard-deploy.mjs"]
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "predeploy": ["node scripts/guard-deploy.mjs", "npm run build"]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["node scripts/guard-deploy.mjs", "npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "emulators": {
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}

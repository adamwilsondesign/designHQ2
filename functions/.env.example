# Deploy-time parameters for Cloud Functions (copy to functions/.env.<project-id>)
GEMINI_MODEL=gemini-2.5-pro
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=https://us-central1-<project-id>.cloudfunctions.net/googleOAuthCallback
APP_URL=https://<project-id>.web.app
# Secrets (set with `firebase functions:secrets:set NAME`):
#   GEMINI_API_KEY, GOOGLE_OAUTH_CLIENT_SECRET, OAUTH_STATE_SECRET

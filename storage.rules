rules_version = '2';

// Mirrors firestore.rules. Role is read from the (default) Firestore database of
// the same project, which is where the rebuild stores /users.
service firebase.storage {
  match /b/{bucket}/o {

    function lazerAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@lazertechnologies[.]com$');
    }

    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return lazerAccount() && role() in ['Super Admin', 'Admin'];
    }

    function isSuperAdmin() {
      return lazerAccount() && role() == 'Super Admin';
    }

    // Proposal templates, client transcripts, meeting transcripts, generated docx.
    match /professional/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Resume, work-in-progress screenshots, generated resume/cover letters.
    match /personal/{uid}/{allPaths=**} {
      allow read, delete: if isSuperAdmin() && request.auth.uid == uid;
      allow write: if isSuperAdmin() && request.auth.uid == uid && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
